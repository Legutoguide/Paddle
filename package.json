{
  "name": "sponsor-qr-manager",
  "productName": "Sponsor QR Manager",
  "version": "1.0.0",
  "description": "Local offline sponsor, campaign and QR coupon management desktop application",
  "main": "dist/main/main.js",
  "author": "Sponsor QR Manager",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "node scripts/watch-main.js",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json --noEmit && node scripts/build-main.js",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/unit/**/*.test.ts",
    "package:win": "node scripts/package-win.js",
    "package:win:portable": "node scripts/package-win.js portable",
    "rebuild:electron": "node scripts/rebuild-native-win.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "start": "electron ."
  },
  "dependencies": {
    "@types/pngjs": "^6.0.5",
    "better-sqlite3": "^11.3.0",
    "date-fns": "^3.6.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.441.0",
    "nanoid": "^5.0.7",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
